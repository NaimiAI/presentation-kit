{
  "schemaVersion": "naimi.presentation.v1",
  "id": "client-onboarding",
  "name": "New-client welcome pack",
  "description": "A post-signature document: meet the team, a first-30-days plan with dates counted from kickoff, materials and contacts",
  "entry": "index.html",
  "preview": "preview.webp",
  "personalization": {
    "fields": [
      {
        "key": "companyName",
        "label": "Company",
        "placeholder": "Client's company name",
        "type": "text",
        "required": true
      },
      {
        "key": "managerName",
        "label": "Account manager",
        "placeholder": "First and last name",
        "type": "text"
      },
      {
        "key": "managerContact",
        "label": "Manager's contact",
        "placeholder": "Email / handle / phone",
        "type": "text"
      },
      {
        "key": "startDate",
        "label": "Kickoff date",
        "type": "date"
      }
    ],
    "showCustomFields": false
  },
  "demoData": {
    "namespace": "clientOnboarding",
    "fields": []
  },
  "engine": "nk/0.10.0",
  "slides": [
    {
      "id": "welcome",
      "title": "Welcome (loud: hero plate, bleed)"
    },
    {
      "id": "team",
      "title": "Team (quiet: paper, photos pasted into the craft)"
    },
    {
      "id": "first-month-plan",
      "title": "First 30 days (mid: the mountain band opens the slide)"
    },
    {
      "id": "resources",
      "title": "Resources (loud: terracotta field, the trophy cut-out)"
    }
  ]
}
