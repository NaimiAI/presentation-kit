{
  "schemaVersion": "naimi.presentation.v1",
  "id": "listing-presentation",
  "name": "Home tour presentation",
  "description": "Image-led presentation of a home an agent is selling to a buyer: nearby sales from a simple text field with an automatic price check, three purchase paths sharing one adaptive calculator (financed, all cash, buy-before-you-sell), a four-frame photo tour, and a buyer self-fill move timeline",
  "entry": "index.html",
  "preview": "preview.webp",
  "personalization": {
    "fields": [
      {
        "key": "companyName",
        "label": "Buyer name(s)",
        "placeholder": "e.g. Emma & Noah Sullivan",
        "type": "text",
        "required": true
      },
      {
        "key": "propertyAddress",
        "label": "Property address",
        "placeholder": "e.g. 4128 SE Woodstock Blvd, Portland, OR",
        "type": "text"
      },
      {
        "key": "homeSpecs",
        "label": "Spec line under the address",
        "placeholder": "2,780 sq ft · 0.28 acre lot · 4 bedrooms",
        "type": "text"
      },
      {
        "key": "presentDate",
        "label": "Presentation date",
        "type": "date"
      },
      {
        "key": "homeHighlights",
        "label": "What makes the home worth seeing (one per line)",
        "placeholder": "Built by the owners in 2019\nGreat room with a fireplace and 18-ft ceiling\nDetached studio with its own entrance",
        "type": "textarea"
      },
      {
        "key": "compsLines",
        "label": "Recent sales nearby — one per line: Address | Sold price | Days on market",
        "placeholder": "4102 SE 42nd Ave | $748,000 | 21\n3820 SE Steele St | $739,000 | 34",
        "type": "textarea"
      },
      {
        "key": "askingPrice",
        "label": "Asking price",
        "placeholder": "$725,000",
        "type": "text"
      },
      {
        "key": "bookingUrl",
        "label": "Tour booking link (optional)",
        "placeholder": "https://calendly.com/claire-bennett/private-tour",
        "type": "text"
      }
    ],
    "showCustomFields": false
  },
  "demoData": {
    "namespace": "listing",
    "fields": [
      {
        "key": "purchaseOption",
        "label": "Purchase path",
        "type": "string",
        "defaultValue": "mortgage",
        "promoteToClientFacts": true
      },
      {
        "key": "downPayment",
        "label": "Down payment or equity applied",
        "type": "number",
        "defaultValue": 0,
        "promoteToClientFacts": true
      },
      {
        "key": "moveTimeline",
        "label": "Move timeline",
        "type": "string",
        "defaultValue": "",
        "collectFromClient": true,
        "promoteToClientFacts": true
      },
      {
        "key": "buyerQuestions",
        "label": "Buyer questions",
        "type": "string",
        "defaultValue": "",
        "collectFromClient": true
      }
    ]
  },
  "engine": "nk/0.10.0",
  "slides": [
    {
      "id": "cover",
      "title": "Cover"
    },
    {
      "id": "house",
      "title": "The home & the block"
    },
    {
      "id": "purchase",
      "title": "How to buy it"
    },
    {
      "id": "tour",
      "title": "Walk the house"
    },
    {
      "id": "why-this-home",
      "title": "Why this home"
    },
    {
      "id": "next-steps",
      "title": "Next steps"
    }
  ]
}
